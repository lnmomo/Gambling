APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/runtime/football_agents.db

# Official schedule / SP sync
# browser: public page via a normal browser; authorized_api: licensed JSON feed.
OFFICIAL_FEED_MODE=browser
OFFICIAL_SOURCE_URL=https://m.sporttery.cn/mjc/zqsj/?tab=schedule
# In authorized_api mode, the response must be a list or {"matches": [...]} with
# the canonical fields: source_match_id, league, home_team, away_team,
# match_date (YYYY-MM-DD), match_time (HH:MM), sale_status, odds{home,draw,away}.
OFFICIAL_AUTHORIZED_API_URL=
OFFICIAL_AUTHORIZED_API_TOKEN=
OFFICIAL_AUTHORIZED_API_HEADERS_JSON={}
OFFICIAL_RESULTS_SOURCE_URL=https://www.sporttery.cn/jc/zqsgkj/
OFFICIAL_RESULTS_LOOKBACK_DAYS=60
# Chromium-family browser used by the official data sync (CDP).
# Leave empty to auto-detect Edge/Chrome from common install locations and PATH.
OFFICIAL_BROWSER_PATH=
OFFICIAL_FETCH_TIMEOUT_SECONDS=25
OFFICIAL_MIN_SYNC_INTERVAL_SECONDS=60
OFFICIAL_AUTO_SYNC_INTERVAL_SECONDS=3600

# External market odds
THE_ODDS_API_KEY=
ODDS_API_REGIONS=eu
ODDS_API_MIN_REQUESTS_REMAINING=20
EXTERNAL_ODDS_CAPTURE_WINDOW_MINUTES=180
PROSPECTIVE_FREE_MODE=true
PROSPECTIVE_MONTHLY_CREDIT_BUDGET=450
PROSPECTIVE_CREDIT_RESERVE=50
PROSPECTIVE_MAX_ACTIVE_SPORTS=3
PROSPECTIVE_SNAPSHOT_OFFSETS_HOURS=6,1
# Conservative stress assumption; replace with the rate shown for your exchange account/package.
EXCHANGE_COMMISSION_RATE=0.05
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT_KEYS=soccer_fifa_world_cup,soccer_finland_veikkausliiga
ODDS_API_AUTO_SPORT_KEYS=true
INTERNATIONAL_ODDS_SPORT_KEYS=soccer_fifa_world_cup,soccer_uefa_european_championship,soccer_conmebol_copa_america,soccer_uefa_nations_league,soccer_fifa_world_cup_qualifiers
# Paid historical endpoint: charged per requested region and h2h market. The importer
# archives raw timestamped snapshots and rejects snapshots taken at/after kickoff.
INTERNATIONAL_ODDS_API_REGIONS=uk,eu

ENABLE_REAL_SYNC=false
ENABLE_PROSPECTIVE_RESEARCH=true
PROSPECTIVE_RESEARCH_STUDY_NAME=frozen-ensemble-market-anchor-v2-t60-confirmation-2026-oos200
PROSPECTIVE_RESEARCH_MIN_SETTLED=200
PROSPECTIVE_RESEARCH_MIN_DAYS=180
ENABLE_STACKING_MODEL=false
ENABLE_AUTO_BETTING=false

OFFICIAL_SP_REFRESH_MINUTES=15
EXTERNAL_ODDS_REFRESH_MINUTES=15
LIVE_FAST_REFRESH_MINUTES=5
BACKGROUND_AGENT_INTERVAL_SECONDS=3600
AUTO_BACKTEST_CSV_PATH=football_agents/sample_data/historical_matches.csv
PROFIT_SCORER_ARTIFACT_PATH=reports/market_anchored_sp1_home_avg_close_shadow_scorer_v1/scorer.json
PROFIT_SCORER_OFFICIAL_POOL_REPORT_PATH=reports/profit_scorer_official_pool/summary.json
PROFIT_SCORER_OFFICIAL_SP_VALIDATION_REPORT_PATH=reports/profit_scorer_official_sp_validation/summary.json
OFFICIAL_SP_EVIDENCE_QUALITY_REPORT_PATH=reports/official_sp_evidence_quality/summary.json
PROFIT_ALLOCATION_READINESS_REPORT_PATH=reports/profit_allocation_readiness_current/summary.json
PAPER_PORTFOLIO_REPORT_PATH=reports/paper_portfolio_current/summary.json
EXTERNAL_CONSENSUS_CHALLENGER_REPORT_PATH=reports/external_consensus_challenger/summary.json

SNAPSHOT_STALE_MINUTES=30

# Database housekeeping (run by the background db-cleanup thread)
# Rows in high-churn mutable tables older than this many days are pruned.
# Set to 0 to disable pruning for a category. Immutable evidence ledgers
# (official odds/result observations, prospective predictions, paper portfolio,
# external consensus decisions) are NEVER deleted — they are permanent audit logs.
DB_RETENTION_DAYS=90
DB_BACKTEST_RETENTION_DAYS=180
# How often the cleanup + VACUUM thread runs (hours). Minimum 1.
DB_VACUUM_INTERVAL_HOURS=24
PRE_MATCH_CLOSE_MINUTES=5
ODDS_MAX_AGE_MINUTES=10

# Qwen / OpenAI-compatible LLM settings. Never commit real keys.
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_NEWS_ITEMS=5

# Historical data sync
HISTORICAL_DATA_BASE_URL=https://www.football-data.co.uk/mmz4281
HISTORICAL_DATA_YEARS_BACK=3
HISTORICAL_DATA_DIVISIONS=E0,E1,E2,E3,SC0,D1,D2,I1,I2,SP1,SP2,F1,F2,N1,B1,P1,T1,G1
HISTORICAL_DATA_WORLDWIDE_DIVISIONS=ARG,AUT,BRA,CHN,DNK,FIN,IRL,JPN,MEX,NOR,POL,ROU,RUS,SWE,SWZ,USA
HISTORICAL_DATA_TIMEOUT_SECONDS=12
HISTORICAL_DATA_WORKERS=8
HISTORICAL_DATA_RETRIES=3
HISTORICAL_DATA_RETRY_BACKOFF_SECONDS=1
# JSON list of authorized historical CSV exports. URLs may be pre-signed HTTPS links;
# do not put credentials in this setting. `league` is used when the CSV has no league column.
# The CSV must contain match date, home/away teams, final score, and pre-match 1X2 odds
# (for example AvgCH/AvgCD/AvgCA). Keep the vendor's as-of timestamp in the delivered file.
# Example: [{"name":"licensed-provider-2025","url":"https://vendor.example/export.csv","league":"K League 1"}]
HISTORICAL_DATA_EXTRA_CSV_SOURCES=[]
INTERNATIONAL_DATA_URL=https://raw.githubusercontent.com/martj42/international_results/master/results.csv
INTERNATIONAL_DATA_TIMEOUT_SECONDS=30
INTERNATIONAL_FOOTBALL_DATA_WORLD_CUP_URL=https://www.football-data.co.uk/WorldCup2026.xlsx

LOG_LEVEL=INFO
